---
import Badge from './ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  level: string;
  duration: string;
  tags?: string[];
  href: string;
}

const { title, description, category, level, duration, tags = [], href } = Astro.props;

const levelColor = level === 'Advanced'
  ? 'bg-orange-500/10 text-orange-400 border-orange-500/20'
  : level === 'Beginner'
  ? 'bg-brand-500/10 text-brand-400 border-brand-500/20'
  : 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20';
---

<article class="card group flex flex-col h-full">
  <div class="flex-1">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <Badge variant="category">{category}</Badge>
      <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full border ${levelColor}`}>{level}</span>
      <span class="text-xs text-surface-500">{duration}</span>
    </div>

    <a href={href}>
      <h3 class="text-lg font-semibold text-white group-hover:text-brand-400 transition-colors mb-2 leading-snug">
        {title}
      </h3>
    </a>

    <p class="text-sm text-surface-400 mb-4 line-clamp-2 leading-relaxed">{description}</p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => (
          <span class="text-[11px] text-surface-500 bg-surface-800/80 px-2 py-0.5 rounded">{tag}</span>
        ))}
      </div>
    )}
  </div>

  <div class="mt-5 pt-4 border-t border-surface-800/60">
    <a href={href} class="inline-flex items-center gap-1 text-sm text-brand-400 group-hover:gap-2 transition-all">
      Започни
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>