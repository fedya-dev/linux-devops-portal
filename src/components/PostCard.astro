---
import Badge from './ui/Badge.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  readTime?: string;
  href: string;
  featured?: boolean;
  heroImage?: string;
  heroImageAlt?: string;
}

const { title, description, pubDate, category, tags = [], readTime, href, featured, heroImage, heroImageAlt } = Astro.props;
---

<article class="group">
  <a href={href} class="block card h-full overflow-hidden !p-0">
    {heroImage && (
      <div class="aspect-video overflow-hidden bg-surface-800">
        <img
          src={heroImage}
          alt={heroImageAlt || title}
          width="800"
          height="450"
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    )}
    <div class={heroImage ? 'p-6' : 'p-6'}>
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <Badge variant="category">{category}</Badge>
        {featured && (
          <span class="text-[10px] uppercase tracking-wider text-orange-400 font-semibold">Featured</span>
        )}
        <span class="text-xs text-surface-500">{formatDate(pubDate)}</span>
        {readTime && (
          <>
            <span class="text-xs text-surface-600">•</span>
            <span class="text-xs text-surface-500">{readTime}</span>
          </>
        )}
      </div>
      <h3 class={`font-semibold text-white mb-3 group-hover:text-brand-400 transition-colors leading-snug ${heroImage ? 'text-xl' : 'text-lg'}`}>
        {title}
      </h3>
      <p class="text-sm text-surface-400 leading-relaxed line-clamp-2 mb-4">
        {description}
      </p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="text-[11px] text-surface-500 bg-surface-800/80 px-2 py-0.5 rounded">{tag}</span>
          ))}
        </div>
      )}
      <div class="mt-5 flex items-center text-sm text-brand-400 opacity-0 group-hover:opacity-100 transition-opacity">
        Прочети повече
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </div>
    </div>
  </a>
</article>