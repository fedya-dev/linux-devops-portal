---
import '../styles/global.css';
import CodeCopy from '../components/CodeCopy.astro';
import { Schema } from 'astro-seo-schema';
import type { WebSite, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Тип на страницата — за по-точна схема */
  pageType?: 'website' | 'article';
  /** За article страници */
  article?: {
    headline: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
    image?: string;
  };
}

const { 
  title = 'LinuxDev Portal — Linux & DevOps',
  description = 'Специализиран технически портал от следващо поколение за Linux, технологии & DevOps.',
  image = '/og-default.webp',
  pageType = 'website',
  article,
} = Astro.props;

const siteUrl = 'https://linuxdev.fedia.eu';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

// WebSite схема — показва на Google името на сайта и търсачката
const websiteSchema: WithContext<WebSite> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'LinuxDev Portal',
  alternateName: 'Linux DevOps Portal',
  url: siteUrl,
  description: description,
  inLanguage: 'bg-BG',
  publisher: {
    '@type': 'Organization',
    name: 'LinuxDev Portal',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
};

// Article схема — само за blog/tutorial страници
const articleSchema = article ? {
  '@context': 'https://schema.org' as const,
  '@type': 'Article' as const,
  headline: article.headline,
  description: description,
  image: article.image ? `${siteUrl}${article.image}` : undefined,
  datePublished: article.datePublished,
  dateModified: article.dateModified || article.datePublished,
  author: {
    '@type': 'Person' as const,
    name: article.author || 'LinuxDev Team',
  },
  publisher: {
    '@type': 'Organization' as const,
    name: 'LinuxDev Portal',
    logo: {
      '@type': 'ImageObject' as const,
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage' as const,
    '@id': currentUrl,
  },
} : null;
---

<!doctype html>
<html lang="bg" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f172a" />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <title>{title}</title>

  <!-- Canonical URL -->
  <link rel="canonical" href={currentUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:site_name" content="LinuxDev Portal" />
  <meta property="og:locale" content="bg_BG" />
  <meta property="og:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />

  <!-- Schema.org: WebSite -->
  <Schema item={websiteSchema} />

  <!-- Schema.org: Article (само за article страници) -->
  {articleSchema && <Schema item={articleSchema} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />

    <main class="flex-1">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Global: Copy button for all code blocks -->
    <CodeCopy />

    <!-- Global: image error handler for any <img> without SafeImage -->
    <script is:inline>
      document.addEventListener('error', function (e) {
        const t = e.target;
        if (t && t.tagName === 'IMG' && !t.dataset.fallbackApplied) {
          t.dataset.fallbackApplied = '1';
          t.src = '/images/fallback.svg';
          t.classList.add('img-fallback');
        }
      }, true);
    </script>
  </body>
</html>
