---
import { footerLinks } from '../data/navigation';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-surface-800 bg-surface-950/80 mt-auto">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-lg shadow-brand-500/20">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
          </div>
          <div>
            <span class="font-display font-bold text-white text-xl">Linux<span class="text-brand-400">Dev</span></span>
            <span class="block text-xs text-surface-500 -mt-0.5">Next-Gen Technical Portal</span>
          </div>
        </a>
        <p class="text-surface-400 text-sm leading-relaxed max-w-sm mb-6">
          Специализиран технически портал от следващо поколение. 
          Linux, Technologies & DevOps — всичко на едно място.
        </p>
      </div>

      {Object.entries(footerLinks).map(([title, links]) => (
        <div>
          <h4 class="font-semibold text-white mb-4 text-sm tracking-wide uppercase">{title}</h4>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-surface-400 hover:text-brand-400 transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 pt-8 border-t border-surface-800 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-surface-500">
        © {currentYear} LinuxDev Portal. Built with <span class="text-brand-400">♥</span> and Astro.
      </p>
      <span class="flex items-center gap-1.5 text-sm text-surface-500">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        System Online
      </span>
    </div>
  </div>
</footer>
