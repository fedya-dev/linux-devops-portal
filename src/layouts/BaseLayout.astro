---
import '../styles/global.css';
import CodeCopy from '../components/CodeCopy.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = 'Linux DevOps Portal — Next-Gen Technical Hub',
  description = 'Специализиран технически портал от следващо поколение за Linux, Technologies & DevOps.',
  image,
} = Astro.props;
---

<!doctype html>
<html lang="bg" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />
    
    <main class="flex-1">
      <slot />
    </main>
    
    <slot name="footer" />

    <!-- Global: Copy button for all code blocks -->
    <CodeCopy />

    <!-- Global: image error handler for any <img> without SafeImage -->
    <script is:inline>
      document.addEventListener('error', function (e) {
        const t = e.target;
        if (t && t.tagName === 'IMG' && !t.dataset.fallbackApplied) {
          t.dataset.fallbackApplied = '1';
          t.src = '/images/fallback.svg';
          t.classList.add('img-fallback');
        }
      }, true);
    </script>
  </body>
</html>
