---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import TutorialCard from '../components/TutorialCard.astro';
import { categories } from '../data/categories';

// Вземаме последните 3 статии
const recentPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({
    type: 'post' as const,
    id: p.id,
    data: p.data,
  }));

// Вземаме последните 3 урока
const recentTutorials = (await getCollection('tutorials'))
  .filter((t) => !t.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((t) => ({
    type: 'tutorial' as const,
    id: t.id,
    data: t.data,
  }));

// Смесваме и сортираме по дата, вземаме първите 6
const recentItems = [...recentPosts, ...recentTutorials]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const features = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: 'Linux Mastery',
    description: 'От kernel tuning до advanced systemd, SELinux, containers и production-ready конфигурации.',
    color: 'from-brand-500 to-emerald-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>`,
    title: 'DevOps Excellence',
    description: 'CI/CD pipelines, Infrastructure as Code, Kubernetes, observability, GitOps и automated everything.',
    color: 'from-cyan-500 to-blue-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    title: 'Modern Technologies',
    description: 'Cloud-native stack, eBPF, WebAssembly, edge computing, AI/ML ops и emerging technologies.',
    color: 'from-violet-500 to-purple-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>`,
    title: 'Hands-on Labs',
    description: 'Интерактивни лаборатории, ready-to-run scripts, Docker environments и real-world scenarios.',
    color: 'from-orange-500 to-amber-600',
  },
];
---

<BaseLayout title="LinuxDev Portal — Next-Gen Technical Hub for Linux & DevOps">
  <Header slot="header" />
  
  <section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32">
    <div class="absolute inset-0 grid-bg opacity-40"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-500/10 rounded-full blur-3xl"></div>
    
    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 badge mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
          Next-Generation Technical Portal
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.1] mb-6">
          Linux. Technologies.<br />
          <span class="glow-text">DevOps.</span>
        </h1>
        
        <p class="text-lg md:text-xl text-surface-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Специализиран технически портал от следващо поколение. 
          Дълбоки знания, практични ръководства и инструменти за професионалисти.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/tutorials" class="btn-primary text-base px-8 py-3.5">
            Започни да учиш
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="/blog" class="btn-secondary text-base px-8 py-3.5">Разгледай блога</a>
        </div>
      </div>

      <div class="mt-16 md:mt-20 max-w-3xl mx-auto">
        <div class="terminal shadow-2xl shadow-brand-500/10">
          <div class="terminal-header">
            <div class="terminal-dot bg-red-500"></div>
            <div class="terminal-dot bg-yellow-500"></div>
            <div class="terminal-dot bg-green-500"></div>
            <span class="ml-3 text-xs text-surface-500 font-mono">user@linuxdev:~</span>
          </div>
          <div class="p-5 space-y-2 text-sm font-mono">
            <div class="flex gap-2">
              <span class="text-brand-400">$</span>
              <span class="text-surface-200">curl -s https://linuxdev.portal/api/status</span>
            </div>
            <div class="text-surface-400 pl-4">
              <span class="text-brand-400">{`{`}</span><br />
              &nbsp;&nbsp;<span class="text-cyan-400">"status"</span>: <span class="text-brand-300">"operational"</span>,<br />
              &nbsp;&nbsp;<span class="text-cyan-400">"topics"</span>: <span class="text-orange-300">["linux", "devops", "k8s", "ebpf"]</span><br />
              <span class="text-brand-400">{`}`}</span>
            </div>
            <div class="flex gap-2 pt-1">
              <span class="text-brand-400">$</span>
              <span class="text-surface-200 animate-pulse">_</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="container-custom">
      <div class="text-center mb-14">
        <h2 class="section-title">Защо LinuxDev Portal?</h2>
        <p class="section-subtitle mx-auto">Не просто още един блог. Специализирана платформа за инженери.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {features.map((feature) => (
          <div class="card group">
            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${feature.color} flex items-center justify-center text-white mb-5 shadow-lg group-hover:scale-110 transition-transform`}>
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="text-xl font-semibold text-white mb-2">{feature.title}</h3>
            <p class="text-surface-400 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="container-custom">
      <div class="text-center mb-14">
        <h2 class="section-title">Последни материали</h2>
        <p class="section-subtitle mx-auto">Свежи статии и уроци</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentItems.map((item) => (
          item.type === 'post' ? (
            <PostCard
              title={item.data.title}
              description={item.data.description}
              pubDate={item.data.pubDate}
              category={item.data.category}
              tags={item.data.tags}
              readTime={item.data.readTime}
              featured={item.data.featured}
              heroImage={item.data.heroImage}
              heroImageAlt={item.data.heroImageAlt}
              href={`/blog/${item.id}`}
            />
          ) : (
            <TutorialCard
              title={item.data.title}
              description={item.data.description}
              category={item.data.category}
              level={item.data.level}
              duration={item.data.duration}
              tags={item.data.tags}
			  heroImage={item.data.heroImage}
			  heroImageAlt={item.data.heroImageAlt}
              href={`/tutorials/${item.id}`}
            />
          )
        ))}
      </div>
      <div class="text-center mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/blog" class="btn-secondary">Виж всички статии</a>
        <a href="/tutorials" class="btn-secondary">Виж всички уроци</a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-surface-900 to-surface-950 border border-surface-700/50 p-10 md:p-16 text-center">
        <div class="absolute inset-0 bg-hero-gradient"></div>
        <div class="relative">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
            Готов ли си за следващото ниво?
          </h2>
          <p class="text-surface-300 max-w-xl mx-auto mb-8 text-lg">
            Присъедини се към community от инженери, които строят модерна инфраструктура.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/tutorials" class="btn-primary">Започни сега</a>
            <a href="/blog" class="btn-secondary">Чети блога</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>