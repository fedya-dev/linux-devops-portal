---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — LinuxDev Portal" description="Страницата не е намерена">
  <Header slot="header" />

  <main class="pt-32 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-30"></div>
    <div class="container-custom relative text-center">
      <div class="badge mb-6">404</div>
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white mb-6">
        Страницата не е намерена
      </h1>
      <p class="text-lg text-surface-400 max-w-xl mx-auto mb-10">
        Съжаляваме, но страницата, която търсите, не съществува или е била преместена.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="btn-primary inline-flex">
          Към началото
        </a>
        <a href="/blog" class="text-brand-400 hover:text-brand-300 font-medium inline-flex items-center gap-1">
          Разгледай блога →
        </a>
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>